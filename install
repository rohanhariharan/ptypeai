#!/bin/sh
# Motif installer — downloads the latest macOS build from ptype.app, installs it
# to /Applications, and clears the Gatekeeper quarantine flag so it opens clean.
#
#   curl -fsSL https://ptype.app/install | sh
#
# The website is the only source of truth for Motif builds.
set -eu

BASE="https://ptype.app"
DEST="/Applications"

if [ "$(uname -s)" != "Darwin" ]; then
  echo "Motif: this installer is for macOS."
  echo "Other builds: ${BASE}/downloads"
  exit 1
fi

# Apple silicon vs Intel
key="macos_arm64"
[ "$(uname -m)" = "x86_64" ] && key="macos_x64"

echo "Motif — finding the latest build…"
path="$(curl -fsSL "${BASE}/downloads/manifest.json" \
  | grep -o "\"${key}\":[[:space:]]*\"[^\"]*\"" \
  | head -1 \
  | sed 's/.*"\([^"]*\)"[[:space:]]*$/\1/')"

if [ -z "${path:-}" ]; then
  echo "Motif: no build found — see ${BASE}/downloads"
  exit 1
fi

url="${BASE}${path}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
dmg="$tmp/motif.dmg"

echo "Motif — downloading $(basename "$url")…"
curl -#fL "$url" -o "$dmg"

echo "Motif — mounting…"
mnt="$(hdiutil attach -nobrowse -readonly "$dmg" | grep -o '/Volumes/.*' | head -1)"
cleanup() { hdiutil detach "$mnt" >/dev/null 2>&1 || true; }
trap 'cleanup; rm -rf "$tmp"' EXIT

# current builds ship Motif.app; older ones shipped Axle.app / ptype.app
if [ -d "${mnt}/Motif.app" ]; then
  APP="Motif.app"
elif [ -d "${mnt}/Axle.app" ]; then
  APP="Axle.app"
else
  APP="ptype.app"
fi

echo "Motif — installing ${APP} to ${DEST}…"
rm -rf "${DEST:?}/${APP}"
cp -R "${mnt}/${APP}" "${DEST}/"

# No Apple Developer account yet: strip the quarantine flag and ad-hoc sign so
# it launches without a "cannot be opened" / "unidentified developer" dialog.
xattr -dr com.apple.quarantine "${DEST}/${APP}" 2>/dev/null || true
codesign --force --deep --sign - "${DEST}/${APP}" >/dev/null 2>&1 || true

echo "Motif — installed. Launching…"
open "${DEST}/${APP}"
echo
echo "Done. Motif needs a model provider — Ollama by default: https://ollama.com"
